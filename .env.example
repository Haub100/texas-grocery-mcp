# Texas Grocery MCP Configuration

# Default HEB store ID (optional; find yours via `store_search`)
HEB_DEFAULT_STORE=

# Redis cache URL (optional for local dev)
REDIS_URL=redis://localhost:6379

# Logging level
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# --- HTTP+OAuth mode (optional) ---
# For remote MCP clients (e.g. claude.ai custom connectors). Leave MCP_HTTP_MODE
# unset/false to run over stdio (the default, for local MCP clients).
MCP_HTTP_MODE=false
MCP_HTTP_PORT=8002
# Public HTTPS URL clients will reach this server at (its Tailscale Funnel URL,
# e.g. https://<TS_HOSTNAME>.<your-tailnet>.ts.net — see TS_HOSTNAME below)
MCP_SERVER_URL=
# Generate with: openssl rand -base64 32
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_CLIENT_ID=texas-grocery-mcp

# --- Tailscale (optional, runs inside the container itself) ---
# Gives this container its own tailnet identity + (with MCP_HTTP_MODE=true) a
# Funnel-exposed public URL, distinct from the host. Leave TS_AUTHKEY unset to
# skip Tailscale entirely (e.g. if you're fronting MCP_HTTP_PORT some other way).
# Generate a reusable key: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=texas-grocery-mcp
