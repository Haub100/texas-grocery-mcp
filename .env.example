# Texas Grocery MCP Configuration

# Default HEB store ID (optional; find yours via `store_search`)
HEB_DEFAULT_STORE=

# Redis cache URL (optional for local dev)
REDIS_URL=redis://localhost:6379

# Logging level
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# --- HTTP+OAuth mode (optional) ---
# For remote MCP clients (e.g. claude.ai custom connectors). Leave MCP_HTTP_MODE
# unset/false to run over stdio (the default, for local MCP clients). When
# enabling, put a TLS-terminating proxy (e.g. `tailscale serve`/`funnel`) in
# front of MCP_HTTP_PORT — this server only speaks plain HTTP itself.
MCP_HTTP_MODE=false
MCP_HTTP_PORT=8002
# Public HTTPS URL clients will reach this server at (e.g. a Tailscale Funnel URL)
MCP_SERVER_URL=
# Generate with: openssl rand -base64 32
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_CLIENT_ID=texas-grocery-mcp
